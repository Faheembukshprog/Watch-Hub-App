rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Products Images (Publicly readable, Admin writable)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profile Images (Owner readable/writable, Admin readable)
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // Support Ticket Attachments
    match /support/{ticketId}/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated(); // Simplified for MVP
      allow write: if isAuthenticated();
    }

    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
